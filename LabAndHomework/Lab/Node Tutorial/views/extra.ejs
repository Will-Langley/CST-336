<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="container my-4">
   <div class="row">
      <div class="col-md-6 text-center">
         <% if (image) { %><img class="planet" src="<%= image %>" alt="<%= title %>"><% } %>
      </div>
      <div class="col-md-6">
         <h1><%= title %></h1>
         <p><%= text %></p>
         <% if (link) { %><a href="<%= link %>" target="_blank">Learn more</a><% } %>
      </div>
   </div>
</main>

<%- include('partials/footer') %>