<%- include('partials/header', { title: 'Quotes' }) %>

    <a href="/" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back</a>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Quotes</h1>
        <a href="/newQuote" class="btn btn-primary">Add Quote</a>
    </div>

    <table class="table table-striped table-hover bg-white">
        <thead>
            <tr>
                <th>Quote</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% for (let quote of quotes)  { %>
                <tr>
                    <td><%= quote.quote %></td>
                    <td class="text-end text-nowrap">
                        <a href="/editQuote?quoteId=<%= quote.quoteId %>" class="btn btn-sm btn-primary">Update</a>
                        <a href="/deleteQuote?quoteId=<%= quote.quoteId %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this quote?')">Delete</a>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

<%- include('partials/footer') %>