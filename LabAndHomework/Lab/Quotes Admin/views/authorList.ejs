<%- include('partials/header', { title: 'Authors' }) %>

    <a href="/" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back</a>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Authors</h1>
        <a href="/newAuthor" class="btn btn-primary">Add Author</a>
    </div>

    <table class="table table-striped table-hover bg-white">
        <thead>
            <tr>
                <th>Name</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% for (let author of authors)  { %>
                <tr>
                    <td><%= author.firstName %> <%= author.lastName %></td>
                    <td class="text-end text-nowrap">
                        <a href="/editAuthor?authorId=<%= author.authorId %>" class="btn btn-sm btn-outline-primary">Update</a>
                        <a href="/deleteAuthor?authorId=<%= author.authorId %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this author and all of their quotes?')">Delete</a>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

<%- include('partials/footer') %>